# Slug the game is registered under on bloxity.io
VITE_GAME_SLUG=monster-truck-of-hell

# Boxity hosting id. When set, the client connects through the Boxity matchmaker
# (Legion.SDK.net.resolveEndpoint). Never point anything at <id>.host.bloxity.io for sockets.
VITE_BLOXITY_HOSTING_ID=

# Local / self-hosted Colyseus server, used only when VITE_BLOXITY_HOSTING_ID is empty.
VITE_SERVER_URL=ws://localhost:2567
