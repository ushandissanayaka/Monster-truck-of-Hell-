PORT=2567

# Slug the game is registered under on bloxity.io
GAME_SLUG=monster-truck-of-hell

# Boxity REST API (only change for staging)
BLOXITY_API_URL=https://api.bloxity.io

# Shared secret Boxity sends in the x-legion-webhook-secret header on Gems purchases
LEGION_WEBHOOK_SECRET=

# Injected automatically by Boxity hosting. Leave empty locally: stat reporting is skipped.
BLOXITY_REPORT_TOKEN=
BLOXITY_GAME_ID=

# Player saves + Gems purchase grants. On Boxity hosting set MONGODB_URI so every pod shares the same
# saves (and they survive redeploys). Empty = JSON files in DATA_DIR (local development).
MONGODB_URI=
DATA_DIR=./data

# Players per room
SEAT_CAP=24

# Comma-separated origins allowed to call the HTTP API (empty = allow all)
CORS_ORIGINS=
